# Copy this file to .env and replace the value with your Discord bot token.
DISCORD_TOKEN=your_discord_bot_token_here
# Optional Postgres connection URL for tracking personal-install users.
DATABASE_URL=postgresql://user:password@host:5432/database
# Optional Netscape-format cookies file for YouTube bot-check challenges.
YOUTUBE_COOKIES_FILE=/app/youtube-cookies.txt
# Optional Cookie header from a verified, logged-in Instagram session.
INSTAGRAM_COOKIE=
# Optional HTTP(S) proxy URL for Instagram requests when the server IP is challenged.
# Configure a proxy endpoint you control or trust; leave empty to connect directly.
INSTAGRAM_PROXY_URL=
# Optional Cookie header for Xiaohongshu posts that require account access.
XIAOHONGSHU_COOKIE=
